# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/soe_database

# Session and Security
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Salesforce OAuth Configuration
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
SALESFORCE_CALLBACK_URL=http://localhost:3001/auth/salesforce/callback

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRO_PRICE_ID=price_your-pro-tier-price-id
STRIPE_ENTERPRISE_PRICE_ID=price_your-enterprise-tier-price-id

# Server Configuration
NODE_ENV=development
PORT=3001
